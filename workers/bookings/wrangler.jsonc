{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nassau-bookings-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "dev": {
    "ip": "localhost",
    "port": 8798,
    "local_protocol": "http"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nassau-bookings-test",
      "database_id": "fd8b46d3-6432-491a-bf03-d03a4a795110",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PAYMENTS_MODE": "test",
    "BOOKINGS_ENABLED": "true",
    "EMAIL_SENDING_ENABLED": "false",
    "EMAIL_FROM": "bookings@notifications.wowatour.com",
    "EMAIL_FROM_NAME": "Nassau Cruise Excursions",
    "EMAIL_REPLY_TO": "hello@nassaucruiseexcursions.com",
    "CORS_ALLOWED_ORIGINS": "http://localhost:8899,http://127.0.0.1:8899,https://nassaucruiseexcursions.com,https://www.nassaucruiseexcursions.com",
    "SITE_BASE_URL": "https://nassaucruiseexcursions.com",
    "ORIGINATING_SITE": "nassaucruiseexcursions.com",
    "ORIGINATING_PORT": "Nassau, Bahamas",
    "OPERATOR_PORTAL_BASE_URL": "https://nassau-bookings-test.dark-violet-8d91.workers.dev"
  }
}
